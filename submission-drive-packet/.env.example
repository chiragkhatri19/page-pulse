# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Timeouts (milliseconds)
AUDIT_TIMEOUT_MS=8000
FETCH_HEADERS_TIMEOUT_MS=5000
MAX_RESPONSE_BYTES=3000000
MAX_REDIRECTS=5

# Concurrency
MAX_CONCURRENT_AUDITS=25
CONCURRENCY_QUEUE_TIMEOUT_MS=2000
MAX_QUEUE_DEPTH=200
MAX_CONCURRENT_AUDITS_PER_HOST=0
HOST_CIRCUIT_FAILURE_THRESHOLD=5
HOST_CIRCUIT_COOLDOWN_MS=60000

# Cache window. Set to 0 to disable caching entirely.
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# Rate limit, per API key or per IP
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Leave false outside tests. True disables the SSRF guard.
ALLOW_PRIVATE_TARGETS=false

USER_AGENT=PagePulse/1.0 (+https://github.com/chiragkhatri19/page-pulse)
