flowchart TB
    Client["Client / reviewer / API caller"]

    subgraph Edge["Edge"]
        CDN["CDN / WAF / TLS\nIP rate limits\nGET cache"]
        LB["Load balancer\nroutes only to ready instances"]
    end

    subgraph API["Stateless API tier\n3 to 6 replicas"]
        Api["Fastify API\nvalidate URL\nSSRF guard\nrate limit\ncache read\nsingle-flight\nbounded fetch"]
    end

    subgraph State["Shared state"]
        Redis[("Redis\nreport cache\nrate-limit buckets\nsingle-flight locks\njob status")]
        Queue[["Redis Streams / BullMQ\ninteractive / scheduled / bulk lanes\nDLQ"]]
        Postgres[("Postgres\naudit history\nAPI keys\nusage records")]
    end

    subgraph Workers["Worker tier\n2 to 10 replicas"]
        Worker["Audit worker\nsame audit core\nlonger deadline\nretry with jitter"]
    end

    subgraph Observability["Observability"]
        OTel["OpenTelemetry collector"]
        Metrics["Prometheus / Loki / Tempo / Grafana"]
        Pager["PagerDuty alerts"]
    end

    Internet[("Target websites")]

    Client --> CDN
    CDN --> LB
    LB --> Api

    Api -->|"cache hit: return report"| Redis
    Api -->|"cache miss: acquire lock"| Redis
    Api -->|"fast origin: fetch and score"| Internet
    Api -->|"slow origin: enqueue and return 202"| Queue
    Api -->|"persist usage/history"| Postgres

    Queue --> Worker
    Worker -->|"fetch with longer budget"| Internet
    Worker -->|"write report and job status"| Redis
    Worker -->|"persist history"| Postgres
    Worker -->|"optional webhook"| Client

    Api -. logs / metrics / traces .-> OTel
    Worker -. logs / metrics / traces .-> OTel
    OTel --> Metrics
    Metrics --> Pager
